{
  "mcpServers": {
    "remoteconnect": {
      "type": "stdio",
      "command": "C:\\path\\to\\remoteconnect-mcp\\.runtime\\Scripts\\python.exe",
      "args": ["-m", "remoteconnect_mcp"],
      "env": {
        "CE_MCP_TOOL_PROFILE": "offline",
        "CE_MCP_ENABLE_ONLINE": "0",
        "CE_MCP_READ_ROOTS": "C:\\path\\to\\remoteconnect-mcp\\workspace",
        "CE_MCP_WRITE_ROOTS": "C:\\path\\to\\remoteconnect-mcp\\workspace"
      }
    }
  }
}
